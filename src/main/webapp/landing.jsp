<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,com.studystack.model.Mission,com.studystack.model.User,com.studystack.util.HtmlUtil" %>
<% List<Mission> featured = (List<Mission>) request.getAttribute("featuredMissions"); List<User> leaders = (List<User>) request.getAttribute("leaders"); %>
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>StudyStack — Learn. Practice. Level Up.</title><meta name="description" content="Practice Java, SQL, and data structures through focused programming missions."><script src="<%= request.getContextPath() %>/assets/js/theme.js"></script><link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/main.css"></head>
<body><jsp:include page="/includes/header.jsp"/>
<main>
    <section class="hero page-shell"><div class="hero-copy"><div class="eyebrow">Learn. Practice. Level Up.</div><h1>Build Your Programming Skills. One Mission at a Time.</h1><p>Practice Java, SQL, and Data Structures through interactive missions. Earn XP, level up, and track your programming journey.</p><div class="hero-actions"><a class="button primary" href="<%= request.getContextPath() %>/auth/register.jsp">Start Learning</a><a class="button" href="<%= request.getContextPath() %>/missions">Explore Missions</a></div><div class="hero-meta"><span>Java</span><span>SQL</span><span>Data structures</span><span>Real progress</span></div></div><div class="hero-panel card"><div class="eyebrow">One mission at a time</div><div class="hero-code"><span class="muted">01</span>  choose a challenge<br><span class="muted">02</span>  think it through<br><span class="muted">03</span>  earn your XP</div><div class="hero-rule"></div><div class="hero-panel-foot"><span class="xp">PRACTICE → PROGRESS</span><span class="badge">Built for focus</span></div></div></section>
    <section class="page-shell landing-section" id="how"><div class="eyebrow">A simple rhythm</div><h2>How StudyStack works</h2><div class="grid three-col"><article class="card"><span class="step">01</span><h3>Choose a mission</h3><p>Pick a topic and difficulty that fits your next learning step.</p></article><article class="card"><span class="step">02</span><h3>Make your move</h3><p>Read carefully, reason through the problem, and commit to an answer.</p></article><article class="card"><span class="step">03</span><h3>Build momentum</h3><p>Earn XP for correct answers and see your level grow as you practice.</p></article></div></section>
    <section class="page-shell landing-section" id="categories"><div class="section-head"><div><div class="eyebrow">Focused practice</div><h2>Three paths to stronger fundamentals</h2></div><a href="<%= request.getContextPath() %>/missions">Browse the library →</a></div><div class="grid three-col"><article class="card category-card"><div class="category-code">01 / JAVA</div><h3>Java</h3><p>Build fluency with language fundamentals and core programming concepts.</p></article><article class="card category-card"><div class="category-code">02 / SQL</div><h3>SQL</h3><p>Practice the queries and relational thinking used to work with data.</p></article><article class="card category-card"><div class="category-code">03 / DSA</div><h3>Data Structures</h3><p>Strengthen algorithmic thinking one approachable challenge at a time.</p></article></div></section>
    <section class="page-shell landing-section"><div class="section-head"><div><div class="eyebrow">Ready when you are</div><h2>Pick a challenge</h2></div><a href="<%= request.getContextPath() %>/missions">All missions →</a></div><% if (featured.isEmpty()) { %><div class="empty">Missions will appear here when the library is ready.</div><% } else { %><div class="grid three-col"><% for (Mission mission : featured) { %><article class="card mission-card"><span class="eyebrow"><%= HtmlUtil.escape(mission.getCategory()) %></span><h3><%= HtmlUtil.escape(mission.getTitle()) %></h3><p><%= HtmlUtil.escape(mission.getDescription()) %></p><div class="card-bottom"><span class="badge"><%= HtmlUtil.escape(mission.getDifficulty()) %></span><span class="xp">+<%= mission.getXpReward() %> XP</span></div></article><% } %></div><% } %></section>
    <section class="page-shell landing-section"><div class="grid two-col"><article class="card progression-card"><div class="eyebrow">Small wins add up</div><h2>Progress you can see</h2><p>Earn XP when you solve a mission correctly. Every 100 XP advances you one level, giving you a clear next milestone without distracting from the practice.</p><div class="level-rule"><span>Level 1</span><b>0–99 XP</b></div><div class="level-rule"><span>Level 2</span><b>100–199 XP</b></div><div class="level-rule"><span>Level 3</span><b>200–299 XP</b></div></article><article class="card"><div class="eyebrow">Consistent practice</div><h2>Choose your pace</h2><div class="difficulty-row"><span class="badge">Easy</span><span>Start with key concepts</span></div><div class="difficulty-row"><span class="badge">Medium</span><span>Connect ideas together</span></div><div class="difficulty-row"><span class="badge">Hard</span><span>Stretch your reasoning</span></div></article></div></section>
    <section class="page-shell landing-section"><div class="section-head"><div><div class="eyebrow">The learning community</div><h2>Leaderboard</h2></div><% if (session.getAttribute("USER_ID") != null) { %><a href="<%= request.getContextPath() %>/student/leaderboard">Full leaderboard →</a><% } %></div><% if (leaders.isEmpty()) { %><div class="empty">The leaderboard will take shape as students complete missions.</div><% } else { %><div class="table-wrap"><table><thead><tr><th>Rank</th><th>Student</th><th>Level</th><th>Missions</th><th>Total XP</th></tr></thead><tbody><% int rank=1; for (User leader : leaders) { %><tr><td><%= rank++ %></td><td><%= HtmlUtil.escape(leader.getUsername()) %></td><td><%= leader.getLevel() %></td><td><%= leader.getCompletedMissions() %></td><td class="xp"><%= leader.getTotalXp() %></td></tr><% } %></tbody></table></div><% } %></section>
    <section class="page-shell landing-cta"><div><div class="eyebrow">Your next step starts here</div><h2>Make practice part of your progress.</h2><p>Sign up, choose a mission, and start building your programming confidence.</p></div><a class="button primary" href="<%= request.getContextPath() %>/auth/register.jsp">Create your account</a></section>
</main><jsp:include page="/includes/footer.jsp"/></body></html>
