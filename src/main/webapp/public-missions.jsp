<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,com.studystack.model.Mission,com.studystack.util.HtmlUtil" %>
<% List<Mission> missions = (List<Mission>) request.getAttribute("missions"); %>
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Explore missions | StudyStack</title><script src="<%= request.getContextPath() %>/assets/js/theme.js"></script><link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/main.css"></head>
<body><jsp:include page="/includes/header.jsp"/><main class="page-shell"><div class="page-head"><div class="eyebrow">Practice library</div><h1>Explore missions</h1><p>Preview the challenges. Sign in to submit answers and track progress.</p></div>
    <% if (missions.isEmpty()) { %><div class="empty">No active missions are available yet.</div><% } else { %><div class="grid mission-grid"><% for (Mission mission : missions) { %><article class="card mission-card"><span class="eyebrow"><%= HtmlUtil.escape(mission.getCategory()) %></span><h3><%= HtmlUtil.escape(mission.getTitle()) %></h3><p><%= HtmlUtil.escape(mission.getDescription()) %></p><div class="card-bottom"><span class="badge"><%= HtmlUtil.escape(mission.getDifficulty()) %></span><span class="xp">+<%= mission.getXpReward() %> XP</span><a class="button" href="<%= request.getContextPath() %>/auth/register.jsp">Start mission</a></div></article><% } %></div><% } %>
</main><jsp:include page="/includes/footer.jsp"/></body></html>
