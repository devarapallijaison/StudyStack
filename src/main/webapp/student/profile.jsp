<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,com.studystack.model.User,com.studystack.model.MissionSubmission,com.studystack.util.HtmlUtil" %>
<% User user = (User) request.getAttribute("user"); List<MissionSubmission> submissions = (List<MissionSubmission>) request.getAttribute("submissions"); long completed = submissions.stream().filter(MissionSubmission::isCorrect).count(); %>
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>My profile | StudyStack</title><script src="<%= request.getContextPath() %>/assets/js/theme.js"></script><link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/main.css"></head>
<body><jsp:include page="/includes/header.jsp"/><div class="app-layout"><jsp:include page="/includes/sidebar.jsp"/><main class="content">
    <div class="page-head"><div class="eyebrow">Your account</div><h1>Profile</h1><p>Your learning progress and mission history.</p></div>
    <section class="grid two-col"><article class="card"><div class="eyebrow">Student</div><h2><%= HtmlUtil.escape(user.getFullName()) %></h2><p>@<%= HtmlUtil.escape(user.getUsername()) %></p><p><%= HtmlUtil.escape(user.getEmail()) %></p></article><article class="card"><div class="stat-label">Level <%= user.getLevel() %></div><div class="stat-value"><%= user.getTotalXp() %> XP</div><p><%= completed %> missions completed · <%= user.getXpToNextLevel() %> XP to next level</p></article></section>
    <section class="section"><div class="section-head"><h2>Mission history</h2></div><% if (submissions.isEmpty()) { %><div class="empty">No mission attempts yet. Choose a mission to get started.</div><% } else { %><div class="table-wrap"><table><thead><tr><th>Mission</th><th>Result</th><th>XP earned</th><th>Submitted</th></tr></thead><tbody><% for (MissionSubmission submission : submissions) { %><tr><td><%= HtmlUtil.escape(submission.getMissionTitle()) %></td><td><span class="badge <%= submission.isCorrect() ? "success" : "error" %>"><%= submission.isCorrect() ? "Completed" : "Attempted" %></span></td><td class="xp"><%= submission.getXpEarned() %></td><td><%= submission.getSubmittedAt() == null ? "" : submission.getSubmittedAt().toString().replace('T',' ') %></td></tr><% } %></tbody></table></div><% } %></section>
</main></div><jsp:include page="/includes/footer.jsp"/></body></html>
